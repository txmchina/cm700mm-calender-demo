      "specs": [
        { "k": "有效辊面宽度", "v": "700 mm" },
        { "k": "主辊直径 (R4/R5)", "v": "Ø530 mm" },
        { "k": "辊缝精度", "v": "±1.0 μm" },
        { "k": "最高工作温度", "v": "180 °C" }
